# ============================================================================
# PADIFIX MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Production URL: https://padifix.vercel.app
# ============================================================================

# --- Supabase PostgreSQL & Auth ---
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://hvxosxhnxauiqrhpyuur.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack Payment Gateway (Nigeria NGN) ---
# Obtain from: Paystack Dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYMENT_LIVE_MODE=false

# --- Resend Transactional Email API ---
# Obtain from: Resend Dashboard -> API Keys / Domains
RESEND_API_KEY=
RESEND_FROM_EMAIL=PadiFix <notifications@padifix.ng>

# --- Application Base URL ---
APP_URL=https://padifix.vercel.app

# ============================================================================
# CRITICAL SECURITY RULE:
# NEVER commit or expose secret keys (PAYSTACK_SECRET_KEY, RESEND_API_KEY, etc.)
# in client-side code, Git commits, screenshots, or logs.
# ============================================================================
